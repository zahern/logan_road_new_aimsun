<configuration>
    <input>
        <net-file value="kg.net.xml"/>
        <additional-files value="detectors.add.xml,demand.add.xml"/>
    </input>
    <time><begin value="0"/><end value="3600"/><step-length value="1.0"/></time>
    <processing><time-to-teleport value="300"/></processing>
    <output><summary-output value="summary.xml"/><tripinfo-output value="tripinfo.xml"/></output>
</configuration>
