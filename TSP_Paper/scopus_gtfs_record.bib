	author = {Zhou, Joseph Q. and Smith, Stephen F. and Jackson, Jay and Chen, Yuxi and Koonce, Peter},
	title = {Mitigating General Transit Feed Specification Message Delays Using Time Series Prediction for Transit Signal Priority},
	year = {2026},
	journal = {Transportation Research Record},
