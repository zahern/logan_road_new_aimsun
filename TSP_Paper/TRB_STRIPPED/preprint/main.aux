\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Kelvin Grove corridor schematic in route order: 12 managed signalised junctions (Aimsun IDs from the corridor configuration) on a 3.2\,km arterial, bus route 345 (red) with the four named cross streets, and the approach/exit/side-street detector layout (magnified inset at J1). Geographic context is shown in \cref  {fig:kg_corridor}.}}{47}{figure.caption.83}\protected@file@percent }
\newlabel{fig:corridor}{{4}{47}{Kelvin Grove corridor schematic in route order: 12 managed signalised junctions (Aimsun IDs from the corridor configuration) on a 3.2\,km arterial, bus route 345 (red) with the four named cross streets, and the approach/exit/side-street detector layout (magnified inset at J1). Geographic context is shown in \cref {fig:kg_corridor}}{figure.caption.83}{}}
\newlabel{fig:corridor@cref}{{[figure][4][]4}{[1][46][]47}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Measured per-junction mainline queue, overlaid on the route order of \cref  {fig:corridor}. Bars are the run-averaged mean mainline queue read from the controller's own \texttt  {queue\_snapshot} logs for a single campaign (2026-09-14: 21 \texttt  {NO\_TSP} runs and 36 \texttt  {CELLQLEARN\_GATED} runs at the same demand), with the percentage change per junction above each pair. The effect is real but heterogeneous and modest: the geometric mean of the per-junction ratio is $0.913$, i.e.\ about a $9\%$ reduction in mean mainline queue, and only 5 of 12 junctions improve individually. This is the \emph  {car-side} ledger and it is deliberately not the objective: the program's gain is bus-passenger-weighted (\cref  {tab:kg_results}), and the junctions where queue rises (J2, J3, J11) are where green is taken from conflicting traffic to serve a bus. That the corridor-wide car cost stays within this band is the work of the balance guard of \cref  {sec:actions}, not an accident. We report the per-junction spread because averaging it away is what makes a priority scheme look free.}}{47}{figure.caption.84}\protected@file@percent }
\newlabel{fig:kg_queue}{{5}{47}{Measured per-junction mainline queue, overlaid on the route order of \cref {fig:corridor}. Bars are the run-averaged mean mainline queue read from the controller's own \texttt {queue\_snapshot} logs for a single campaign (2026-09-14: 21 \texttt {NO\_TSP} runs and 36 \texttt {CELLQLEARN\_GATED} runs at the same demand), with the percentage change per junction above each pair. The effect is real but heterogeneous and modest: the geometric mean of the per-junction ratio is $0.913$, i.e.\ about a $9\%$ reduction in mean mainline queue, and only 5 of 12 junctions improve individually. This is the \emph {car-side} ledger and it is deliberately not the objective: the program's gain is bus-passenger-weighted (\cref {tab:kg_results}), and the junctions where queue rises (J2, J3, J11) are where green is taken from conflicting traffic to serve a bus. That the corridor-wide car cost stays within this band is the work of the balance guard of \cref {sec:actions}, not an accident. We report the per-junction spread because averaging it away is what makes a priority scheme look free}{figure.caption.84}{}}
\newlabel{fig:kg_queue@cref}{{[figure][5][]5}{[1][46][]47}}
