\begin{algorithm}[ht]
\caption{(A0) Master per-epoch pipeline (feasibility shared, commit family-specific)}
\label{alg:master}
\begin{algorithmic}[1]
\Require $\hat{X}_t$ at epoch $(i,t)\in\Tsp^{\text{trig}}$; family generator \textsc{Gen} + commit type A/B/C/D/E (Fig.~\ref{fig:objectives}); $(\theta,\gamma,\kappa_{\text{cool}},H^{\text{det}},Q^{\text{jam}},\sigma^{\text{takeover}},P^{\text{max}},T^{\text{minActive}},H^{\text{hold}})$; congestion limits
\Ensure Committed $a^\star=(k^\star,\delta^\star)$ or \texttt{NO\_ACTION}; optional learner update
\State read $\hat{X}_t$ \Comment detector/timer/empty trigger, 30\,s debounce, $\le1$ grant/cycle, minActive + NA-hold
\State $\mathcal{A} \gets \textsc{Gen}(\hat{X}_t)$ \Comment family candidates (Algs.~A1--A8), integer $\delta$
\State drop $a\in\mathcal{A}$ violating \cref{eq:online_det,eq:online_monitor} \Comment horizon, cooldown, spillback, phase, recover, minActive, hold, Purdue, monitor
\If{$\hat{\sigma}^+>\sigma^{\text{takeover}}$} relax detection and cooldown lines only \EndIf
\If{cross-pax/bus-pax $>2.5$ or saturation $>$ arm limit (0.65--0.75)} \Return \texttt{NO\_ACTION} \EndIf
\For{$a \in \mathcal{A}$} estimate $\text{bps}(a)$, $\text{cpc}(a)$ (+ cascade/Purdue where gated) \EndFor
\State drop $a$ if $\text{cpc}(a)>\theta\cdot\text{bps}(a)$ \textbf{or} bus saving $<\gamma$ \textbf{or} $Z_4(a)>Z_4^{\text{fix}}+\varepsilon_{Z_4}$ \Comment shared vetoes; gated arms add $\text{bps}\le\text{measured-side}+\text{cascade}$ veto
\If{Type~A} dominance-prune survivors; $a^\star \gets \arg\min_a \Delta_{\text{net}}(a)$ \Comment $Z_1$ commit; pruning never changes it
\ElsIf{Type~E} $a^\star \gets \arg\max_a Q(s,a)$ \Comment learned commit; Q already blends $Z_1{+}Z_3$
\ElsIf{Type~B} $a^\star \gets \arg\max$ weighted sum / Nash product s.t.\ C1--C7 \Comment fairness commit
\ElsIf{Type~C} $a^\star \gets \arg\max_p \Pi_p$ + split/re-eval \Comment stability commit
\Else\ $a^\star \gets$ rule cascade (centralised) \Comment Type~D
\EndIf
\State actuate $a^\star$ ($\delta^\star$\,s, 5\,s lock); learners update from realised advantage vs \texttt{NO\_ACTION}
\State \Return $a^\star$
\end{algorithmic}
\end{algorithm}

\begin{algorithm}[ht]
\caption{(A1) Centralised per-second controller (Method 0)}
\label{alg:centralised}
\begin{algorithmic}[1]
\Require Per-second tick; Kalman flows ($\alpha{=}0.3$); 120\,s bus window; candidate pool $\approx$20/junction (GE 3/5/7/10/12/15, INS 10/12/15/20, ER 10/20/30, hold 5/10/15)
\Ensure HOLD, TRANSITION, or PHASE\_ROTATION per junction
\For{all 12 junctions simultaneously}
  \If{no bus within window} \Return HOLD \EndIf
  \State $t_{\text{bus}} \gets \min$ ETA; $e \gets$ elapsed green
  \If{bus phase live \textbf{and} $t_{\text{bus}}<10$} \Return HOLD \EndIf
  \If{bus phase live \textbf{and} $t_{\text{bus}}>20$ \textbf{and} $e>8$} \Return TRANSITION \EndIf
  \If{non-bus phase \textbf{and} $t_{\text{bus}}<15$ \textbf{and} bus phase 1 step away}
    \State \Return TRANSITION iff $\Delta_{\text{bus}}+\Delta_{\text{side}}>\Delta_{\text{main}}$ \textbf{else} HOLD
  \EndIf
  \If{non-bus phase \textbf{and} $t_{\text{bus}}<15$ \textbf{and} bus phase 2 steps away}
    \State \Return PHASE\_ROTATION iff bus benefit $>50\%$ of skipped-phase cost
  \EndIf
\EndFor
\end{algorithmic}
\end{algorithm}

\begin{algorithm}[ht]
\caption{(A2) CPD-QL tabular Q-learning (\texttt{DCTSP\_MARL\_RL}, Method I)}
\label{alg:cpdql}
\begin{algorithmic}[1]
\Require State bins: headway\{late,on-time,early\} $\times$ ETA\{$<$10,[10,30),$\ge$30\} $\times$ delay\{zero,low,high\} $\times$ phase-match\{0,1\} (54 states); actions \{NA, GE\_5/10/15, INS\_10/15/20\}; $w_h{=}0.5$, $\alpha_Q{=}0.1$, $\gamma_Q{=}0.9$
\Ensure Committed $a^\star$ via Alg.~A0 Type~E branch (veto $\theta{=}3.0$ only; no $Z_1$ net gate)
\Function{Train}{$s,a,r,s'$}
  \State $Q(s,a) \gets Q(s,a)+\alpha_Q\,[r+\gamma_Q\max_{a'}Q(s',a')-Q(s,a)]$
\EndFunction
\Function{Act}{$\hat{X}_t$}
  \State $s \gets \text{bin}(\hat{X}_t)$; valid iff GE$\Leftrightarrow$bus-green-live, INS$\Leftrightarrow$red
  \State with prob.\ $\varepsilon$ pick uniform valid $a$, else $a\gets\arg\max_a Q(s,a)$ \Comment $\varepsilon{=}0.30$ train / $0.10$ eval
  \State $r \gets w_h\rho_{\text{bus}}(|\sigma_{\text{in}}|-|\sigma_{\text{out}}(a)|)+(1-w_h)(\text{bps}(a)-\text{cpc}(a))$ \Comment \cref{eq:cpd_reward}, pax\,s
  \State observe $s'$; \Call{Train}{$s,a,r,s'$}
  \State \Return $a$ \Comment avoidance of harmful grants is learned, hence early-episode harm
\EndFunction
\end{algorithmic}
\end{algorithm}

\begin{algorithm}[ht]
\caption{(A3) WaveGate Harmony Search + LWR (\texttt{DCTSP\_ZIG}, Method II; GE-only in scored runs)}
\label{alg:wavegate}
\begin{algorithmic}[1]
\Require Harmony memory $\mathcal{H}$, $|\mathcal{H}|{=}10$, integer $\delta\in[\delta_{\min},\delta_{\max}]$; HMCR $0.9$, PAR $0.3$; balance 0.35 (0.6 GE), MIN\_GAIN 15\,s, veto $\theta{=}3.0$, congestion 0.65
\Ensure Winning $\delta^\star$ through Alg.~A0 Type~A branch, else \texttt{NO\_ACTION}
\State initialise $\mathcal{H}$ with random integer $\delta$
\State seed $\delta_0 \gets \max(0,\,n_0/(q_{\text{sat}}-q_{\text{arr}})-d_b^{\text{NA}})$ \Comment closed-form LWR, \cref{eq:lwr}
\State improvise $\delta$: with prob.\ HMCR pick from $\mathcal{H}$ else random; with prob.\ PAR perturb $\pm\Delta$; round to integer
\State evaluate $J(\delta)$ via LWR shockwave; replace worst of $\mathcal{H}$ if beaten
\State $\delta^\star \gets \arg\min_{\delta\in\mathcal{H}} J(\delta)$
\If{bus benefit $>$ car cost (\cref{eq:wavegate_balance})} \Return $\delta^\star$ \Else\ \Return \texttt{NO\_ACTION} \EndIf
\end{algorithmic}
\end{algorithm}

\begin{algorithm}[ht]
\caption{(A4) CellSearch CTM grid (\texttt{DCTSP\_MP\_ECTM}, Method III; deterministic)}
\label{alg:ctmgs}
\begin{algorithmic}[1]
\Require CTM cells and cascade (Sec.~\ref{sec:ctm}, Eqs.~\eqref{eq:ctm_send}--\eqref{eq:ctm_cascade}); grid $\delta\in\{5,\dots,10\}$; SELFORG bus delay $\ge15$\,s; balance 0.8; $\theta{=}3.0$
\Ensure $\delta^\star$ through Alg.~A0 Type~A branch ($\sim$1000 cell-updates/event)
\For{integer $\delta \in \{5,\dots,10\}$}
  \State forward-simulate CTM $T$ steps; accumulate bus-queue delay, side delay $D_{\text{side}}(\delta)$
\EndFor
\State $\delta^\star \gets \arg\min_\delta Z(\delta)$
\If{bus delay $<15$\,s \textbf{or} side/bus $>0.8$} \Return \texttt{NO\_ACTION} \EndIf
\State \Return $\delta^\star$ \Comment same state always gives same $\delta^\star$
\end{algorithmic}
\end{algorithm}

\begin{algorithm}[ht]
\caption{(A5) CellQLearn family (\texttt{CELLQLEARN} / \_GATED / \_SAFE / \_FORCED, Method IV)}
\label{alg:cellqlearn}
\begin{algorithmic}[1]
\Require 128-bin state (CTM bus queue $\times$ pressure ratio $\times$ phase $\times$ ETA); deficit-solver durations (GE cap 10, INS cap 12); warm-started $Q$, neighbour-shared updates ($w{=}0.5$), 135\,s cycle cap, $\le1$ intervention/cycle; variant parameters in \cref{tab:methods} (\texttt{CELLQLEARN} / \_GATED / \_SAFE / \_FORCED)
\Ensure Committed $a^\star$ via Alg.~A0: Type~A $Z_1$ commit for the gated variants (\_GATED/\_SAFE), Type~E $Q$-argmax + analytic cost veto for the un-gated core
\Function{Propose}{$\hat{X}_t$}
  \State $(k,\delta) \gets$ deficit-solver$(\hat{X}_t)$; $s \gets \text{bin}(\hat{X}_t)$
  \State $r \gets -(\text{queue}+\text{wait}+\text{side})$ advantage vs \texttt{NO\_ACTION}
  \State $\varepsilon$-greedy pick; $Q$-update as in Alg.~A2
  \State \Return $(k,\delta)$
\EndFunction
\Function{Gate}{$a$} \Comment champion \texttt{\_GATED} only
  \State propagate released platoon hop-by-hop; charge post-arrival saturation with superlinear spillback severity
  \State \Return $[\text{bps}(a) > \text{measured-side}(a) + \text{cascade}(a)]$ \Comment veto only if net $\le0$
\EndFunction
\end{algorithmic}
\end{algorithm}

\begin{algorithm}[ht]
\caption{(A6) Nash bargaining (\texttt{DCTSP\_BARGAIN\_SPM} weighted-sum; \texttt{NASH\_BARGAIN} product, Method V)}
\label{alg:nash}
\begin{algorithmic}[1]
\Require Players = phases $(i,p)$ ($\approx$48 on Kelvin Grove); disagreement $\eta_{i,p}=$ negative spillback risk; C1--C7 feasibility; MIN\_GAIN 5\,s; cascade in cpc
\Ensure Winner via Alg.~A0: Type~A $Z_1$ commit for Weighted (SPM), Type~B product commit for \texttt{NASH\_BARGAIN}
\Function{Weighted}{$a$} \Comment \texttt{DCTSP\_BARGAIN\_SPM}; GR via DE optimiser
  \State $r \gets w_A w_{\text{bus}}\text{bps}-(1+w_B)\text{risk}\cdot\text{cascade}\cdot\text{cpc}+\text{main-saving}+20\cdot\mathbf{1}[a{=}\text{NA}]$
  \State \Comment ETA-tiered bus weights 1.6/1.35/1.10; risk $1{+}1.8\cdot\text{unc}$; cascade mult.\ 2.0; congestion 0.75; veto 3.0; hard net-benefit gate
  \State \Return $r$
\EndFunction
\Function{Product}{$\mathcal{A}$} \Comment \texttt{NASH\_BARGAIN}
  \State $\text{bps}\gets$ bus pax\,s saved $+$ mainline through-traffic pax\,s saved on the served phase (\cref{eq:nash_util}); green-wave hand-off seconds stay bus-only
  \State Tier~1: keep frontier with surplus $\text{bps}-\text{cpc}>0$; pick $\arg\max \text{bps}^{p_T}\text{surplus}^{p_C}$, $(p_T,p_C){=}(0,1)$ \Comment pure net surplus $=$ min total pax delay, \cref{eq:nash_product}
  \State Tier~2: corridor Gauss--Seidel best-response $\times10$ (tol 0.01, neighbour 0.5), integer durations, congestion 0.70
  \State \Return winner
\EndFunction
\end{algorithmic}
\end{algorithm}

\begin{algorithm}[ht]
\caption{(A7) MARL heuristic (\texttt{DCTSP\_MARL}) -- no Q-table (cf.\ Alg.~A2)}
\label{alg:marl}
\begin{algorithmic}[1]
\Require Pools GE/INS/GR/VP/OC/PT; $w_A,w_C,w_H{=}0.5$; 3-hop downstream chain; GR enabled; veto 3.0; congestion 0.70
\Ensure Winner via Alg.~A0 Type~A branch on global score + $Z_4$ veto
\For{$a \in$ pool} \State $\text{local}(a) \gets w_A(\text{bus}+\text{main})-w_C\,\text{cross}$ \EndFor
\For{$a$} \State $\text{global}(a) \gets \text{local}(a)-\text{chain-cost}(a)$ \Comment additive chain coupling, not joint optimisation
\EndFor
\State \Return $\arg\max_a \text{global}(a)$
\end{algorithmic}
\end{algorithm}

\begin{algorithm}[ht]
\caption{(A8) Passenger-weighted max-pressure + helpers (GR/VP/PT)}
\label{alg:mp}
\begin{algorithmic}[1]
\Require Pressures $\pi_m=n_m-|\mathcal{O}(m)|^{-1}\sum_o n_o$, bus queue $\times40$, car $\times1.5$; FIX: per-cycle split; FLEX: re-eval per $T_A$; LB: dwell $>5$\,s blockage scaling + downstream-saturation discount $>0.6$
\Ensure Binary actuation via Alg.~A0 Type~C branch (veto 3.0, congestion 0.70); the GR/VP/PT helpers below are available, but the scored FIX/FLEX/LB arms exercise only the base pressure policy
\State $p^\star \gets \arg\max_p\sum_{m\in p}\max(\pi_m,0)$
\If{pressured phase live} extend $\min(\text{share},10)$ \Else\ cut $\min(\text{cut},10)$ if $\ge3$\,s \EndIf
\Function{GR}{$i,\Delta$} \Comment zero-cycle-cost reallocation, Sec.~\ref{sec:sol_gr}
  \If{$g_{i,p}^0-\Delta\ge G_i^{\min}\;\forall p\in\mathcal{P}_i^c$} $g_{i,p_b}\gets g_{i,p_b}^0+\Delta$; $g_{i,p}\gets g_{i,p}^0-\Delta/|\mathcal{P}_i^c|$ \EndIf
\EndFunction
\Function{VP}{$i$} skip to chosen next phase subject to invalid-action masking (queue + consecutive-skip rules) \EndFunction
\Function{PT}{$i$} re-split greens via Webster allocation over chosen sequence \EndFunction
\end{algorithmic}
\end{algorithm}

\begin{algorithm}[ht]
\caption{(A9) CellQLearn-v2 dense per-junction MDP (design variant, not scored)}
\label{alg:cellqlearn_v2}
\begin{algorithmic}[1]
\Require state $s_{i,t}$ (\cref{eq:cq2_state}); families $\{\textsc{Hold},\textsc{Extend},\textsc{End-early}\}$; duration grids $\mathcal{D}_{\text{GE}}/\mathcal{D}_{\text{ER}}$; CTM rollout $F^{\text{CTM}}$ (Eqs.~\eqref{eq:ctm_send}--\eqref{eq:ctm_update}); reward $R^{\text{c}}$ (\cref{eq:cq2_reward}); $\alpha,\gamma,\varepsilon$; recoverability and Purdue gates R8--R9
\Ensure Committed family (and magnitude) per junction each tick, with or without a bus
\Function{Propose}{$s_{i,t}$}
  \State if $s_{i,t}$ unvisited: $Q_i^{(0)}(s,a)\gets R^{\text{c}}(s,a)\;\forall a$ \Comment heuristic-seeded optimistic init, \cref{eq:cq2_init}
  \State $f^\star \gets \varepsilon$-greedy $\arg\max_a Q_i(s,a)$
  \State $\delta^\star \gets \arg\max_{\delta\in\mathcal{D}_{f^\star}} R^{\text{c}}\bigl(F^{\text{CTM}}(\hat{X}_t,(f^\star,\delta))\bigr)$ \Comment magnitude on the CTM rollout
  \State \Return $(f^\star,\delta^\star)$
\EndFunction
\State observe $s'_{i}$; $Q_i(s,a)\gets Q_i(s,a)+\alpha\bigl[R^{\text{c}}(s,a)+\gamma\max_{a'}Q_i(s',a')-Q_i(s,a)\bigr]$ \Comment \cref{eq:cq2_qupdate}
\end{algorithmic}
\end{algorithm}

