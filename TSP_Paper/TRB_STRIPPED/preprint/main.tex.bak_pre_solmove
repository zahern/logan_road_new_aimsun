\centering
\caption{Shared algorithm notation. Every quantity is integer-valued at 1\,s resolution.}
\label{tab:alg_notation}
\footnotesize
\begin{tabular}{@{}p{3.7cm}p{13.2cm}@{}}
\hline
Symbol & Meaning \\
\hline
$t$, $\Delta t{=}1$\,s & Decision step; fixed step length \\
$\hat{X}_t$ & Estimated corridor state at epoch $t\in\Tsp^{\text{trig}}$: live phase + remaining, measured queues $\hat{Q}$, ETA $\hat{\eta}\pm\hat{\sigma}$ (absent if no bus), lateness $\hat{\sigma}^+$, downstream saturation, POG $\hat{\pi}^{\text{POG}}$, pressures, grant history \\
