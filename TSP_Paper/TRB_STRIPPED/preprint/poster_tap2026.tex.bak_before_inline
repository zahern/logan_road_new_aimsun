% tikzposter has \settitle only (it REPLACES the whole title template, so all
% of \@title/\@author/\@institute/\@titlegraphic must be typeset here). There
% is no \setsubtitle -- the showcase line is typeset literally instead.
% Compact title style: less dead space above/below the title bar.
\definetitlestyle{TAPcompact}{
  width=720mm, roundedcorners=30, linewidth=0.4cm, innersep=0.6cm,
  titletotopverticalspace=5mm, titletoblockverticalspace=6mm,
  titlegraphictotitledistance=10pt, titletextscale=1
}{
    \begin{scope}[line width=\titlelinewidth, rounded corners=\titleroundedcorners]
        \draw[color=framecolor, fill=titlebgcolor]%
        (\titleposleft,\titleposbottom) rectangle (\titleposright,\titlepostop);
    \end{scope}
}
\usetitlestyle{TAPcompact}

% Compact blocks: the class default spends 1 cm of padding on every side of every
% title bar and body, which dominated the poster's white space.
\defineblockstyle{TAPtight}{
  titlewidthscale=1, bodywidthscale=1, titlecenter,
  titleoffsetx=0pt, titleoffsety=0pt, bodyoffsetx=0pt, bodyoffsety=0pt,
  bodyverticalshift=0pt, roundedcorners=20, linewidth=0.28cm,
  titleinnersep=0.55cm, bodyinnersep=0.55cm
}{
  \begin{scope}[line width=\blocklinewidth, rounded corners=\blockroundedcorners]
    \ifBlockHasTitle
      \draw[color=blocktitlebgcolor, fill=blocktitlebgcolor] (blockbody.south west) rectangle (blocktitle.north east);
      \draw[color=blocktitlebgcolor, fill=blockbodybgcolor] (blockbody.south west) rectangle (blockbody.north east);
    \else
      \draw[color=blocktitlebgcolor, fill=blockbodybgcolor] (blockbody.south west) rectangle (blockbody.north east);
    \fi
  \end{scope}
}
\useblockstyle{TAPtight}
% Remove the class's "LaTeX TikZposter" corner watermark for the final print.
\tikzposterlatexaffectionproofoff
% The class default wraps \title content in an unbreakable \scalebox, making a
% long one-line title overflow the title parbox; use wrappable text instead.
\makeatletter
\def\title#1{\gdef\@title{#1}}
\makeatother
\settitle{
  \centering\vbox{
    \color{titlefgcolor}\bfseries
    {\LARGE \@title\par}
    \vspace*{0.3em}
    {\large\itshape Transport Academic Partnership (TAP) Poster Showcase 2026\par}
    \vspace*{0.5em}
    {\large \@author\par}
    \vspace*{0.2em}
    {\normalsize \@institute\par}
  }
}

