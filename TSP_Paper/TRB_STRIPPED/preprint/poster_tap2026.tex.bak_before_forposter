\column{0.30}

\block{Aim}{
  At every bus detection the controller picks \textbf{one action} --- extend, truncate, insert, skip, rotate, or re-align an upstream offset.\\[3pt]
  \textbf{Goal:} keep buses on schedule \emph{and} keep the arterial green wave flowing.\\[3pt]
  Eight online logics are compared on the corridor in Aimsun Next microsimulation, against an exact optimisation reference.
}

\block{Corridor \& Trial}{
  \textbf{Corridor:} Kelvin Grove Road, Brisbane\\
  \textbf{Signals:} 12 junctions, 3.2\,km\\
  \textbf{Bus:} route 345, $\sim$10\,min headways\\
  \textbf{Trial:} Aimsun Next, 5 seeds, 1.25\,h peak\\
  \textbf{Yardstick:} exact optimisation reference
}

% ---- COLUMN 2 ----------------------------------------------------------------
\column{0.38}

\block{How to Read the Figures}{
  \textbf{Action panels:} hollow vehicles = traffic \textit{at the decision instant}; solid = \textit{after} the action; the light/dark squares = signal aspect (green/red) for \textbf{main} vs \textbf{cross} street.\\[2pt]
  \textbf{Schedule:} each band = one signal's green through time; each tilted line = a bus riding the staggered greens --- the \emph{green wave}. Numbered marks = the actions firing.
}

\block{Outcomes / Findings}{
  \begin{itemize}
    \item \textbf{One action logic improved:} passenger delay $-5.5\%$ (5 seeds); buses 8.4\% faster, cars 4.8\%.
    \item Runner-up (multi-agent heuristic): $-1.7\%$ total (buses $-19.9\%$).
    \item \textbf{13 of 15 logics harmful} on this well-timed, car-dominated corridor --- actions must respect the wave.
    \item What works: late-bus-only priority, person-delay gates, corridor coordination.
  \end{itemize}
}

