\block{How the Corridor Green Wave Holds When Actions Fire}{
\begin{tikzpicture}[
  x=0.170cm, y=0.460cm,
  crossgrn/.style={fill=gray!28, draw=gray!45, line width=0.3pt},
  busgrn/.style={fill=corridorgreen, draw=corridorgreen!70!black, line width=0.3pt},
  insertph/.style={fill=carblue, draw=carblue!70!black, line width=0.3pt},
  extph/.style={fill=corridorgreen, draw=corridorgreen!70!black, densely dashed, line width=0.9pt},
    grph/.style={fill=grviol!65, draw=grviol!85!black, line width=0.9pt},
    rotph/.style={fill=corridorgreen!72!black, draw=corridorgreen!80!black, line width=1.0pt},
    traj/.style={busred, line width=1.6pt, ->, >=Stealth},
    traj2/.style={busopp, line width=1.6pt, ->, >=Stealth},
    schd/.style={circle, draw=black, fill=white, inner sep=1.6pt, line width=0.8pt},
    cal/.style={circle, draw=black!70, fill=white, inner sep=0.7pt, line width=0.5pt,
                font=\tiny\bfseries, text=black},
    ann/.style={font=\scriptsize, align=left},
    halo/.style={fill=white, rounded corners=2pt, inner sep=1.5pt},
  gridln/.style={gray!35, line width=0.4pt, densely dotted},
]
  % --- light vertical gridlines every 60 s (reading aid) ---
  \foreach \t in {0,60,120,180,240} {
    \draw[gridln] (\t,0.5) -- (\t,12.5);
  }
  % --- baseline cyclic settings per intersection (80 s cycle, 35 s bus green) ---
  \foreach \i in {1,...,12} {
    \pgfmathtruncatemacro{\off}{mod((\i-1)*10, 80)}
    \fill[crossgrn] (0,\i-0.36) rectangle (245,\i+0.36);
    \foreach \c in {0,80,160} {
      \pgfmathtruncatemacro{\gstart}{\c+\off}
      \pgfmathtruncatemacro{\gend}{min(\c+\off+35,245)}
      \fill[busgrn] (\gstart,\i-0.36) rectangle (\gend,\i+0.36);
    }
  }
  % --- settings changes enacted by the schedule ---
  % Green Extension at intersection 3: bus green 20-55 extended to 65
  \fill[extph] (55,2.66) rectangle (65,3.34);
  % Phase Insertion at intersection 7: extra bus-priority phase 80-95
  \fill[insertph] (80,6.64) rectangle (95,7.36);
  % Early Red at intersection 10: next bus green pulled 10 s earlier (170 -> 160)
  \fill[busgrn] (160,9.64) rectangle (170,10.36);
  \draw[busred, densely dashed, line width=0.9pt] (160,9.55) -- (160,10.45);
  % Green Reallocation at intersection 5: bus green starts 10 s earlier (110
  % instead of 120), donor cross phase shortened by the same 10 s (net 0)
  \fill[grph] (110,4.64) rectangle (120,5.36);
  % Offset Correction at intersection 11: downstream green start shifts 5 s
